{
  "name": "coup",
  "version": "1.0.0",
  "description": "Coup Game",
  "private": true,
  "author": {
    "name": "Davi Inácio",
    "url": "https://github.com/daviinacio"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "pre-commit": "yarn build",
    "build": "yarn workspaces run build",
    "dev:client": "yarn workspace @coup/client run dev",
    "dev:server": "yarn workspace @coup/server run dev",
    "dev": "run-p dev:* --print-label",
    "start:client": "yarn workspace @coup/client run preview",
    "start:server": "yarn workspace @coup/server run start",
    "start": "run-p start:* --print-label"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daviapps/coup.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/daviapps/coup/issues"
  },
  "homepage": "https://github.com/daviapps/coup#readme",
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
